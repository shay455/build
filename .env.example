# Database — libSQL. Leave unset for a local file at data/app.db.
# A serverless deployment has no writable disk, so it must be set there.
#   DATABASE_URL=libsql://<your-db>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create`>
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# Market data source. Default: fixtures from the seed inventory.
# `nadlan` enables the Israel Tax Authority adapter, which has NOT been verified
# against the live service — see src/lib/sources/nadlan.ts before using it.
# MARKET_SOURCE=nadlan
# NADLAN_ENDPOINT=
# NADLAN_TIMEOUT_MS=8000
# MARKET_CACHE_TTL_MS=86400000

# Parcel resolution order. Default: the local gazetteer only.
# `govmap` adds the official geocoder, also unverified against the live service.
# PARCEL_SOURCE=gazetteer,govmap
# GOVMAP_ENDPOINT=
# GOVMAP_TIMEOUT_MS=8000
