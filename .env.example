# ---- WhatsApp Cloud API (Meta) ----
# From Meta for Developers > your app > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # permanent System User token, NOT the 24h temporary one
WA_APP_SECRET=              # app > Settings > Basic > App Secret (used to verify webhook signatures)
WA_VERIFY_TOKEN=change-me   # any string; paste the same value in the webhook config
WA_API_VERSION=v23.0
# Your own WhatsApp number (the operator), international format without +. Only this number may run commands.
OPERATOR_PHONE=9725XXXXXXXX

# ---- AI providers ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
CLAUDE_BRIEF_MODEL=claude-opus-5
CLAUDE_UTILITY_MODEL=claude-haiku-4-5
FAL_KEY=                    # optional; needed only for the "סרטון" command
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/standard/image-to-video

# ---- Infra ----
DATABASE_URL=postgres://adbot:adbot@localhost:5432/adbot
REDIS_URL=redis://localhost:6379
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000   # the https URL Meta calls (ngrok/cloudflared in dev)
DATA_DIR=./data
USD_ILS=3.35
LOG_LEVEL=info
