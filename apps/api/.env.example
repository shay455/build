# Copy to .env (or export in your shell). Never commit real keys.
PORT=4000
LOG_LEVEL=info
# "anthropic" for real calls, "mock" for local dev and tests without a key
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Leave empty to run an embedded Postgres (PGlite) under ./data/pglite — fine for dev.
# Production: postgres://user:pass@host:5432/bombot
DATABASE_URL=
UPLOAD_DIR=./data/uploads
# Comma-separated domains the model may never cite from
BLOCKED_DOMAINS=
CORS_ORIGIN=http://localhost:3000
