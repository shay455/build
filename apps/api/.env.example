# Copy to .env (or export in your shell). Never commit real keys.
PORT=4000
LOG_LEVEL=info
# "anthropic" for real calls, "mock" for local dev and tests without a key
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Leave empty to run an embedded Postgres (PGlite) under ./data/pglite — fine for dev.
# Production: postgres://user:pass@host:5432/bombot
DATABASE_URL=
UPLOAD_DIR=./data/uploads
# Comma-separated domains the model may never cite from
BLOCKED_DOMAINS=
CORS_ORIGIN=http://localhost:3000

# ---- Phase B ----
# Public base URL of the API (used for image links sent to Telegram)
PUBLIC_API_URL=http://localhost:4000
# Operator dashboard + kill switch (/api/admin/*). Empty disables admin routes. Generate: openssl rand -hex 24
ADMIN_TOKEN=
# Telegram mention bot (@BotFather). Turn OFF privacy mode so the bot sees group messages for thread context.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=bombot
TELEGRAM_WEBHOOK_SECRET=
# Image generation on a free provider: cloudflare | pollinations | mock
IMAGE_PROVIDER=pollinations
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
